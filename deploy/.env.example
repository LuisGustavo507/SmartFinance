# Copie para deploy/.env e preencha. Nunca versione o arquivo .env.

# Domínio público com registro DNS tipo A apontando para o IP da VM.
SMARTFINANCE_DOMAIN=financeiro.seudominio.com.br

POSTGRES_DB=smartfinance
POSTGRES_USER=smartfinance
# Gere com: openssl rand -base64 32
POSTGRES_PASSWORD=troque-esta-senha

# Gere com: openssl rand -base64 48
SMARTFINANCE_JWT_SECRET=troque-este-segredo

# Beta fechado: só emails cadastrados em convite_beta podem criar conta.
SMARTFINANCE_INVITE_REQUIRED=true
SMARTFINANCE_TIME_ZONE=America/Sao_Paulo

# Limites por cliente (janela em memória, uma réplica).
SMARTFINANCE_LOGIN_FAILURES=10
SMARTFINANCE_REGISTER_LIMIT=5

# Backup local feito por deploy/backup.sh.
BACKUP_DIR=/var/backups/smartfinance
BACKUP_RETENTION_DAYS=14
